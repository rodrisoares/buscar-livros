# URL base da API de favoritos (json-server). Sem esta variável, usa http://localhost:3001
VITE_API_URL=http://localhost:3001

# Endpoint do formulario de contato (Formspree, Basin...). Vazio = abre o cliente de e-mail.
VITE_CONTACT_ENDPOINT=

# Chave da Google Books API (console.cloud.google.com > APIs > Books API > Credenciais).
# Sem ela, as consultas usam a cota anonima compartilhada e retornam 429 quando ela esgota.
VITE_GOOGLE_BOOKS_API_KEY=
